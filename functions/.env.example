# 이 파일을 functions/.env.ryuso-game 으로 복사해서 쓴다(그 파일은 git 에 올라가지 않는다).
# 실제 Firebase 프로젝트 ryuso-game 의 Realtime Database 값(콘솔과 같아야 한다).
# 데이터베이스 트리거는 데이터베이스와 같은 지역에 배포해야 하므로 FUNCTIONS_REGION 도 asia-southeast1.
FUNCTIONS_REGION=asia-southeast1
DATABASE_INSTANCE=ryuso-game-default-rtdb
DATABASE_URL=https://ryuso-game-default-rtdb.asia-southeast1.firebasedatabase.app
# Web Push 공개 키(npx web-push generate-vapid-keys --json 의 publicKey). 앱의 VITE_WEB_PUSH_PUBLIC_KEY 와 같은 값.
WEB_PUSH_PUBLIC_KEY=
# 연락처: mailto: 주소나 https 주소
WEB_PUSH_SUBJECT=mailto:your-contact@example.com
# WEB_PUSH_PRIVATE_KEY 는 여기 넣지 않는다: firebase functions:secrets:set WEB_PUSH_PRIVATE_KEY --project ryuso-game
