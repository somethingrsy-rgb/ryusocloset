# Match the region and instance shown in the Firebase Realtime Database console.
FUNCTIONS_REGION=us-central1
DATABASE_INSTANCE=ryuso-game-default-rtdb
DATABASE_URL=https://ryuso-game-default-rtdb.firebaseio.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_SUBJECT=mailto:your-contact@example.com
# WEB_PUSH_PRIVATE_KEY must be stored with firebase functions:secrets:set, never here.
