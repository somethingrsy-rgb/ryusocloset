{
  "rules": {
    ".read": false,
    ".write": false,
    "lobby": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'room', 'x', 'z', 'dir', 'moving', 'look', 't'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "room": {
            ".validate": "newData.val() === 'cafe' || newData.val() === 'farm' || newData.val() === 'walk' || newData.val() === 'none'"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "dir": {
            ".validate": "newData.val() === 1 || newData.val() === -1"
          },
          "moving": {
            ".validate": "newData.isBoolean()"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "look": {
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "outfit": {
              "$slot": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "chat": {
        ".read": "auth != null",
        ".indexOn": [
          "t"
        ],
        "$msg": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 't'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "boss": {
        ".read": "auth != null",
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'z', 'hp', 'max', 't']) && ((data.exists() && data.child('hp').val() > 0 && newData.child('id').val() === data.child('id').val() && newData.child('type').val() === data.child('type').val() && newData.child('x').val() === data.child('x').val() && newData.child('z').val() === data.child('z').val() && newData.child('max').val() === data.child('max').val() && newData.child('hp').val() < data.child('hp').val() && newData.child('hp').val() >= data.child('hp').val() - 3) || ((!data.exists() || (data.child('hp').val() === 0 && now - data.child('t').val() > 8000)) && newData.child('id').val() !== data.child('id').val() && newData.child('hp').val() === newData.child('max').val()))",
        "id": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 24"
        },
        "type": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
        },
        "hp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "max": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 60"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
