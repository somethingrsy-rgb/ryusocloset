{
  "rules": {
    ".read": false,
    ".write": false,
    "push": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 400"
      }
    },
    "lobby": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'room', 'x', 'z', 'dir', 'moving', 'look', 't'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "room": {
            ".validate": "newData.val() === 'cafe' || newData.val() === 'farm' || newData.val() === 'walk' || newData.val() === 'home' || newData.val() === 'none'"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "dir": {
            ".validate": "newData.val() === 1 || newData.val() === -1"
          },
          "moving": {
            ".validate": "newData.isBoolean()"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "look": {
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "outfit": {
              "$slot": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          },
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "eat": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        }
      },
      "chat": {
        ".read": "auth != null",
        ".indexOn": [
          "t"
        ],
        "$msg": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 't'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          "home": {
            ".validate": "newData.val() === auth.uid"
          },
          "race": {
            ".validate": "newData.isString() && newData.val().matches(/^r[1-6]$/)"
          },
          "jump": {
            ".validate": "newData.isString() && newData.val().matches(/^j[1-4]$/)"
          },
          "star": {
            ".validate": "newData.isString() && newData.val().matches(/^s1$/)"
          },
          "bub": {
            ".validate": "newData.isString() && newData.val().matches(/^b1$/)"
          }
        }
      },
      "homes": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'room', 't'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "room": {
            ".validate": "newData.hasChild('scene') && (newData.hasChild('room') || newData.child('place').isString())"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "food": {
        ".read": "auth != null",
        "$host": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))",
            ".validate": "newData.hasChildren(['menu', 'x', 'y', 'by', 't'])",
            "menu": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            },
            "uid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "kind": {
              ".validate": "newData.val() === 'order' || newData.val() === 'served'"
            }
          }
        }
      },
      "bosses": {
        ".read": "auth != null",
        "$room": {
          ".write": "auth != null && newData.exists()",
          ".validate": "($room === 'walk' || $room === 'farm' || $room === 'cafe') && newData.hasChildren(['id', 'type', 'x', 'z', 'hp', 'max', 't']) && ((data.exists() && data.child('hp').val() > 0 && newData.child('id').val() === data.child('id').val() && newData.child('type').val() === data.child('type').val() && newData.child('x').val() === data.child('x').val() && newData.child('z').val() === data.child('z').val() && newData.child('max').val() === data.child('max').val() && newData.child('hp').val() < data.child('hp').val() && newData.child('hp').val() >= data.child('hp').val() - 3) || ((!data.exists() || (data.child('hp').val() === 0 && now - data.child('t').val() > 8000)) && newData.child('id').val() !== data.child('id').val() && newData.child('hp').val() === newData.child('max').val()))",
          "id": {
            ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 24"
          },
          "type": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "hp": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "max": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 60"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "race": {
        ".read": "auth != null",
        "$room": {
          ".validate": "$room.matches(/^r[1-6]$/)",
          ".write": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid || now - data.child('meta/t').val() > 600000)",
          "meta": {
            ".validate": "newData.hasChildren(['host','seed','startAt','t'])",
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "seed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "startAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['name','car','d','x','speed','t'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "car": {
                ".validate": "newData.val() === 'heart' || newData.val() === 'cloud' || newData.val() === 'blue' || newData.val() === 'bunny' || newData.val() === 'star'"
              },
              "d": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -3 && newData.val() <= 3"
              },
              "speed": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
              },
              "fin": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "jump": {
        ".read": "auth != null",
        "$room": {
          ".validate": "$room.matches(/^j[1-4]$/)",
          "meta": {
            ".validate": "newData.hasChildren(['host','seed','started','t'])",
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "seed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "started": {
              ".validate": "newData.isBoolean()"
            },
            "order": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 64 && $i.matches(/^[0-3]$/)"
              }
            },
            "cpus": {
              "$i": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && $i.matches(/^[0-3]$/)"
              }
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || now - data.child('t').val() > 600000)"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && now - root.child('lobby/jump/'+$room+'/meta/t').val() > 600000))",
              ".validate": "newData.hasChildren(['name','t'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "moves": {
            "$n": {
              ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['s','t'])",
              ".write": "auth != null && !data.exists() && newData.exists() && root.child('lobby/jump/'+$room+'/meta/started').val() === true && (root.child('lobby/jump/'+$room+'/meta/order/'+newData.child('s').val()).val() === auth.uid || (root.child('lobby/jump/'+$room+'/meta/host').val() === auth.uid && (root.child('lobby/jump/'+$room+'/meta/order/'+newData.child('s').val()).val() === 'cpu' || !root.child('lobby/jump/'+$room+'/players/'+root.child('lobby/jump/'+$room+'/meta/order/'+newData.child('s').val()).val()).exists())))",
              "s": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "fr": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
              },
              "fc": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
              },
              "tr": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
              },
              "tc": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
              },
              "e": {
                ".validate": "newData.val() === 1"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              }
            },
            ".write": "auth != null && !newData.exists() && (root.child('lobby/jump/'+$room+'/meta/host').val() === auth.uid || now - root.child('lobby/jump/'+$room+'/meta/t').val() > 600000)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "star": {
        ".read": "auth != null",
        "$room": {
          ".validate": "$room.matches(/^s[1-4]$/)",
          "meta": {
            ".validate": "newData.hasChildren(['host','phase','t'])",
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "phase": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'done'"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
            },
            "target": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "startAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999999999999"
            },
            "endAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999999999999"
            },
            "part": {
              "$u": {
                ".validate": "newData.val() === 1"
              }
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || now - data.child('t').val() > 600000)"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && now - root.child('lobby/star/'+$room+'/meta/t').val() > 600000))",
              ".validate": "newData.hasChildren(['name','t'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "ready": {
                ".validate": "newData.isBoolean()"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -13 && newData.val() <= 13"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
              },
              "j": {
                ".validate": "newData.isNumber()"
              },
              "cap": {
                "n": {
                  ".validate": "newData.isNumber()"
                },
                "r": {
                  ".validate": "newData.isNumber()"
                },
                "$o": {
                  ".validate": false
                }
              },
              "say": {
                "k": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
                },
                "n": {
                  ".validate": "newData.isNumber()"
                },
                "$o": {
                  ".validate": false
                }
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              },
              "look": {
                ".validate": "newData.isString() && newData.val().length <= 900"
              }
            }
          },
          "state": {
            ".write": "auth != null && (root.child('lobby/star/'+$room+'/meta/host').val() === auth.uid || (!newData.exists() && now - root.child('lobby/star/'+$room+'/meta/t').val() > 600000))",
            ".validate": "newData.hasChildren(['r','caught','res'])",
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
            },
            "caught": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "res": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            },
            "ev": {
              "n": {
                ".validate": "newData.isNumber()"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -13 && newData.val() <= 13"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
              },
              "$o": {
                ".validate": false
              }
            },
            "acc": {
              "$u": {
                ".validate": "newData.isNumber()"
              }
            },
            "stars": {
              "$i": {
                ".validate": "$i.matches(/^[0-2]$/) && newData.hasChildren(['id','x','y','m'])",
                "id": {
                  ".validate": "newData.isNumber()"
                },
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= -13 && newData.val() <= 13"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
                },
                "m": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
                },
                "$o": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "bub": {
        ".read": "auth != null",
        "$room": {
          ".validate": "$room.matches(/^b1$/)",
          "meta": {
            ".validate": "newData.hasChildren(['host','phase','t'])",
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "phase": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'play'"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
            },
            "part": {
              "$u": {
                ".validate": "newData.val() === 1"
              }
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || now - data.child('t').val() > 600000 || (newData.child('host').val() === auth.uid && root.child('lobby/bub/'+$room+'/players/'+auth.uid).exists() && !root.child('lobby/bub/'+$room+'/players/'+data.child('host').val()).exists()))"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && now - root.child('lobby/bub/'+$room+'/meta/t').val() > 600000))",
              ".validate": "newData.hasChildren(['name','t'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "look": {
                ".validate": "newData.isString() && newData.val().length <= 900"
              },
              "ready": {
                ".validate": "newData.isBoolean()"
              },
              "p": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "sh": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "j": {
                ".validate": "newData.isNumber()"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "state": {
            ".write": "auth != null && (root.child('lobby/bub/'+$room+'/meta/host').val() === auth.uid || (!newData.exists() && now - root.child('lobby/bub/'+$room+'/meta/t').val() > 600000))",
            ".validate": "newData.hasChildren(['r','lv','ph','sc','li','st','f','b','fr','bo','pl','n'])",
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
            },
            "lv": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
            },
            "ph": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "sc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "li": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
            },
            "st": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
            },
            "f": {
              ".validate": "newData.isString() && newData.val().length <= 700"
            },
            "b": {
              ".validate": "newData.isString() && newData.val().length <= 700"
            },
            "fr": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "bo": {
              ".validate": "newData.isString() && newData.val().length <= 90"
            },
            "pl": {
              ".validate": "newData.isString() && newData.val().length <= 400"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
