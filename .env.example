# 멀티플레이어(Firebase) 웹 앱 설정 — 이 파일을 .env.local 로 복사해서 값을 채운다(.env.local 은 git 에 올라가지 않는다).
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)의 firebaseConfig 값. 서비스 계정 비공개 키는 넣지 않는다.
# 값이 없으면 「같이 놀기」 단추가 나오지 않고 앱은 지금처럼 혼자 놀기로 동작한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ryuso-game.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://ryuso-game-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=ryuso-game
VITE_FIREBASE_APP_ID=

# Web Push 공개 키만 넣습니다. 비공개 키는 Cloud Functions Secret Manager에 저장합니다.
VITE_WEB_PUSH_PUBLIC_KEY=
