{
  "name": "ryuso-closet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "assets": "tsx scripts/build-assets.ts && tsx scripts/build-icons.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:economy": "node --experimental-strip-types --test tests/economy.test.ts",
    "test:room-mvp": "node --experimental-loader ./tests/loader.mjs --test tests/economy.test.ts tests/roomSlots.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.8",
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
